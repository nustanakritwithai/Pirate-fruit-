NODE_ENV=development
HOST=0.0.0.0
PORT=10000
DATABASE_URL=postgresql://pirate_fruit:pirate_fruit@localhost:5432/pirate_fruit
CLIENT_ORIGIN=http://localhost:5173
SERVER_VERSION=0.4.0
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
ADMIN_DEBUG_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
ENABLE_REMOTE_SESSION=false
ENABLE_ECONOMY_SERVER=false
ENABLE_REMOTE_SAVE=false
ENABLE_TRADE_SERVER=false
ENABLE_REALTIME=false
# S10: Server ตัดสินสถานะเควสต์+รางวัล (ต้องเปิด ENABLE_REMOTE_SESSION ก่อน)
ENABLE_QUEST_SERVER=false
# S11: Server ตัดสินรางวัลจากการฆ่ามอนสเตอร์ (ต้องเปิด ENABLE_REMOTE_SESSION ก่อน)
ENABLE_MONSTER_SERVER=false
# S12: level เดินจาก EXP ที่ Server แจกเอง (ต้องเปิด ENABLE_QUEST_SERVER + ENABLE_MONSTER_SERVER ก่อน)
ENABLE_PROGRESSION_SERVER=false
# S13: presence relay ให้ผู้เล่นเห็นกันเคลื่อนที่ (ต้องเปิด ENABLE_REALTIME ก่อน)
ENABLE_MULTIPLAYER=false
# S15: PvP combat authority — Server เป็นเจ้าของ HP/ดาเมจการต่อสู้ระหว่างผู้เล่น (ต้องเปิด ENABLE_MULTIPLAYER ก่อน)
ENABLE_PVP=false
# S16: มอนสเตอร์กลาง — Server จำลอง AI/HP/death/respawn แล้ว push snapshot/delta (ต้องเปิด ENABLE_MULTIPLAYER ก่อน)
ENABLE_SHARED_WORLD_MONSTERS=false
ENABLE_BOAT_WORLD=false
# Destructive rollback stays disabled unless this exact value is supplied.
# DATABASE_ROLLBACK_CONFIRM=rollback-s4-core
ENABLE_CHARACTER_SELECT=false
