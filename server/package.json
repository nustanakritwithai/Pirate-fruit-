{
  "name": "pirate-fruit-server",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node --enable-source-maps dist/persistence/runMigrations.js",
    "db:migrate:dev": "tsx src/persistence/runMigrations.ts",
    "db:rollback": "node --enable-source-maps dist/persistence/runRollback.js",
    "db:rollback:dev": "tsx src/persistence/runRollback.ts",
    "db:seed": "node --enable-source-maps dist/persistence/runSeed.js",
    "db:seed:dev": "tsx src/persistence/runSeed.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "smoke": "node scripts/smoke-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.1.0",
    "@pirate-fruit/shared": "file:../shared",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.10",
    "pg-mem": "^3.0.5",
    "tsx": "^4.20.0",
    "vitest": "^4.1.10"
  }
}
